rules_version = '2';

// Spec Section 5: a user may only touch documents under their own uid,
// and that uid must belong to a non-anonymous account — guest (anonymous)
// data must never land in Firestore before linking.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /habits/{habitId} {
        allow read, write: if isOwner(uid);

        match /check_ins/{date} {
          allow read, write: if isOwner(uid);
        }
      }
    }
  }
}
