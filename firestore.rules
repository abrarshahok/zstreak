rules_version = '2';

// Spec Section 5: a user may only touch documents under their own uid,
// and that uid must belong to a non-anonymous account — guest (anonymous)
// data must never land in Firestore before linking.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // A deactivated ('inactive') or admin-'restrict'-ed account's habit
    // data must be genuinely inaccessible, not just hidden by the app's
    // own UI — enforced here, not just client-side, since a client check
    // is a suggestion and a security rule is the actual guarantee.
    //
    // The exists() check is not optional: almost no account has ever had
    // /users/{uid} itself actually written — nothing touched that parent
    // doc directly until AccountStatusRepository, which only runs on
    // deactivate/reactivate. get(...).data on a document that was never
    // created evaluates to null, not an empty map, so calling .get() on
    // it is a runtime rule error — and Firestore rules fail CLOSED on any
    // runtime error. Without this check, that one omission denied every
    // read and write to profile/habits/check_ins for every account that
    // had simply never deactivated, not just the ones that had.
    function isActive(uid) {
      return !exists(/databases/$(database)/documents/users/$(uid))
        || get(/databases/$(database)/documents/users/$(uid)).data.get('status', 'active') == 'active';
    }

    // A self-reactivate write (flipping status back to 'active') is only
    // honored within the 30-day window recorded at deactivation time, and
    // never at all once the stored status is 'restrict' — an admin action,
    // not something a client write should ever undo. Checked against
    // request.time (the server's clock at the moment of this write), so
    // there's no separate scheduled job needed to "close" the window —
    // it's closed the instant the deadline passes, enforced right here.
    function canSelfReactivate(uid) {
      let doc = get(/databases/$(database)/documents/users/$(uid)).data;
      return doc.get('status', 'active') != 'restrict'
        && (doc.get('reactivationDeadline', null) == null
            || request.time < doc.reactivationDeadline);
    }

    // Backstops against unbounded document creation — rules can only see a
    // single document at a time, never "how many siblings already exist",
    // so these counts are maintained by Cloud Functions triggers
    // (onHabitCreated/onHabitDeleted, onCategoryCreated/onCategoryDeleted
    // in functions/src/index.ts) rather than computed here. Caps are
    // deliberately generous — this is an abuse backstop against a direct,
    // non-UI API write spamming documents, not the product's free-tier
    // limit (3 habits, AppConfig.freeTierHabitLimit), which is enforced
    // client-side only; a real user should never come close to these.
    function habitCountBelow(uid) {
      return get(/databases/$(database)/documents/users/$(uid))
        .data.get('habitCount', 0) < 1000;
    }

    function categoryCountBelow(uid) {
      return get(/databases/$(database)/documents/users/$(uid))
        .data.get('categoryCount', 0) < 300;
    }

    // Bounds on individual habit doc fields — a signed-in account is free
    // to create (one tap, no payment) and the app's own `.limit(50)`
    // habit-list query and 60/200-char name/description text fields are
    // UI-only conveniences with no server-side backing on their own, so
    // anyone with valid (even brand-new, free) auth could otherwise write
    // arbitrarily large field values straight through the Firestore API,
    // bypassing the app UI entirely. Limits here are generous relative to
    // the client's own caps (60/200 chars) specifically so no legitimate
    // write is ever rejected.
    //
    // Sibling *count* (as opposed to a single doc's field sizes) is capped
    // separately by habitCountBelow()/categoryCountBelow() above, and
    // check_ins/mood_entries by the {date}-format check on their own doc
    // IDs — see those functions and match blocks for why each collection
    // needed a different approach.
    function isValidHabitWrite(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.emoji is string && data.emoji.size() <= 32
        && data.colorHex is string && data.colorHex.size() <= 16
        && data.frequencyType is string && data.frequencyType.size() <= 32
        && data.frequencyConfig is map && data.frequencyConfig.size() <= 20
        && (data.get('reminderTime', null) == null
            || (data.reminderTime is string && data.reminderTime.size() <= 16))
        && (data.get('description', null) == null
            || (data.description is string && data.description.size() <= 1000))
        && data.currentStreak is int && data.currentStreak >= 0 && data.currentStreak <= 100000
        && data.longestStreak is int && data.longestStreak >= 0 && data.longestStreak <= 100000
        && data.sortOrder is int
        && (data.get('categoryId', null) == null
            || (data.categoryId is string && data.categoryId.size() <= 64))
        && (data.get('targetCount', null) == null
            || (data.targetCount is int && data.targetCount >= 0 && data.targetCount <= 1000000))
        && (data.get('targetUnit', null) == null
            || (data.targetUnit is string && data.targetUnit.size() <= 32))
        && (data.get('isQuitHabit', null) == null || data.isQuitHabit is bool);
    }

    function isValidCheckInWrite(data) {
      return data.completed is bool
        && (data.get('status', null) == null
            || (data.status is string
                && data.status in ['completed', 'missed', 'skipped']))
        && (data.get('value', null) == null
            || (data.value is int && data.value >= 0 && data.value <= 1000000))
        && (data.get('note', null) == null
            || (data.note is string && data.note.size() <= 1000));
    }

    function isValidCategoryWrite(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 60
        && data.emoji is string && data.emoji.size() <= 32
        && data.colorHex is string && data.colorHex.size() <= 16;
    }

    function isValidMoodWrite(data) {
      return data.moodScore is int && data.moodScore >= 1 && data.moodScore <= 5
        && (data.get('energyScore', null) == null
            || (data.energyScore is int && data.energyScore >= 1 && data.energyScore <= 5))
        && (data.get('note', null) == null
            || (data.note is string && data.note.size() <= 1000));
    }

    match /users/{uid} {
      // Deliberately not gated by isActive() — the account doc is where
      // status itself lives, and the owner must always be able to read
      // it (to know they're deactivated) and, within limits, write it.
      allow read: if isOwner(uid);
      // A brand-new doc can't already have an expired deadline, so create
      // is unconditional for the owner.
      allow create: if isOwner(uid);
      // Any update that does NOT set status to 'active' is unrestricted
      // (deactivating is always allowed instantly) — only the specific
      // "become active again" transition is gated.
      allow update: if isOwner(uid)
        && (request.resource.data.get('status', 'active') != 'active'
            || canSelfReactivate(uid));

      // Profile data collected during onboarding (name, age, gender, goals).
      match /profile/{docId} {
        allow read, write: if isOwner(uid) && isActive(uid);
      }

      match /habits/{habitId} {
        allow read, delete: if isOwner(uid) && isActive(uid);
        allow create: if isOwner(uid) && isActive(uid)
          && isValidHabitWrite(request.resource.data)
          && habitCountBelow(uid);
        allow update: if isOwner(uid) && isActive(uid)
          && isValidHabitWrite(request.resource.data);

        // {date} is a client-chosen doc ID (see local_date.dart's
        // localDateString) with nothing else constraining it — without
        // this format check, a non-anonymous account could write
        // unlimited garbage-ID documents here directly via the API,
        // bypassing the app entirely. A real user's check-ins are already
        // naturally bounded to one per calendar day, so this closes the
        // gap without a maintained counter (which would either cap
        // legitimate years-long history or need to be implausibly high
        // to avoid ever blocking a real long-time user).
        match /check_ins/{date} {
          allow read, delete: if isOwner(uid) && isActive(uid);
          allow create, update: if isOwner(uid) && isActive(uid)
            && isValidCheckInWrite(request.resource.data)
            && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
        }
      }

      match /categories/{categoryId} {
        allow read, delete: if isOwner(uid) && isActive(uid);
        allow create: if isOwner(uid) && isActive(uid)
          && isValidCategoryWrite(request.resource.data)
          && categoryCountBelow(uid);
        allow update: if isOwner(uid) && isActive(uid)
          && isValidCategoryWrite(request.resource.data);
      }

      // Same {date}-format reasoning as check_ins above.
      match /mood_entries/{date} {
        allow read, delete: if isOwner(uid) && isActive(uid);
        allow create, update: if isOwner(uid) && isActive(uid)
          && isValidMoodWrite(request.resource.data)
          && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }
    }
  }
}
