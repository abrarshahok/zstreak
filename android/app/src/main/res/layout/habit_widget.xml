<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <!-- Populated with the mapped habit's data (spec Section 2/12). -->
    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="28sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F5F5F7"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#8A8A96"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_checkin_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_checkin_circle"
            android:contentDescription="Mark today complete"
            android:src="@android:drawable/checkbox_off_background" />
    </LinearLayout>

    <!-- Zero-habit empty state (spec Section 2's widget config note). -->
    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="16dp"
        android:text="No habit selected — tap to add one"
        android:textColor="#8A8A96"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Lapsed-subscriber upsell state (spec Section 6). -->
    <TextView
        android:id="@+id/widget_locked"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="16dp"
        android:text="Subscription expired — tap to renew"
        android:textColor="#8A8A96"
        android:textSize="13sp"
        android:visibility="gone" />

</FrameLayout>
